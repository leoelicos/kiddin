# Copy to `.env` (cp .env.EXAMPLE .env). Every value is optional in development.

# --- Server -------------------------------------------------------------
PORT=3001
# Required in production: a long random string (e.g. `openssl rand -base64 48`).
SESSION_SECRET=

# --- Database -----------------------------------------------------------
# Option A: one connection URL (DATABASE_URL, or JAWSDB_URL on Heroku).
# The scheme picks the dialect: postgres:// / postgresql:// -> Postgres (TLS on
# for non-local hosts, e.g. Neon), mysql:// -> MySQL.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=mysql://user:password@localhost:3306/jk_db

# Option B: discrete credentials (the original MySQL setup; set DB_DIALECT=postgres for Postgres).
# DB_NAME=jk_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306   (defaults to 5432 when DB_DIALECT=postgres)

# Option C (default in development when nothing above is set): zero-config SQLite.
# DB_DIALECT=sqlite
# SQLITE_STORAGE=.data/kiddin.sqlite

# --- Uploads ------------------------------------------------------------
# Where user photos are stored on disk (served at /data/uploads).
# UPLOAD_DIR=uploads
